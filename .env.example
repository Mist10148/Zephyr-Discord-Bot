# ─────────────────────────────────────────────────────────────────────────────
# Zephyr bot configuration template.
# Copy this file to `.env` and fill in your own credentials.
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token

# OpenWeatherMap API key (https://openweathermap.org/api)
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Spotify application credentials (https://developer.spotify.com/dashboard)
# Needed by the BOT for /play with a Spotify link, and by the WEBSITE for the
# dashboard's playlist importer. Set them on both processes if you deploy them
# separately; leaving them off the website only disables that one endpoint, which
# then answers a clear 503 rather than failing obscurely.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ─── Optional overrides (sensible defaults applied if left blank) ───

# Absolute path to ffmpeg.exe. Leave blank to auto-detect the bundled ffmpeg/ folder.
FFMPEG_PATH=

# URL shown by the /use command (web app link). No default: leave it blank and /use
# reports that it is unconfigured, rather than linking somewhere that is not yours.
WEB_APP_URL=

# Flask website host/port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ─── Cloud / container overrides ───

# PORT is set automatically by Render, Heroku, AWS, etc. It overrides FLASK_PORT for the web process.
# PORT=5000

# Optional Redis URL for shared AI settings/history when running multiple bot instances.
# If omitted, settings.json is used locally.
# REDIS_URL=redis://localhost:6379/0

# Persistent SQL database. When unset, Zephyr uses data/zephyr.db locally.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/zephyr
# STORAGE_BACKEND=auto  # auto, database, redis, or file

# Who builds the schema. Unset (the default) decides from DATABASE_URL: SQLite
# creates itself, and a server database belongs to `alembic upgrade head` alone.
# Set it only to override that — e.g. 1 for a throwaway Postgres in CI.
# DB_AUTO_CREATE=

# Echo every SQL statement to the log. Noisy; for debugging a query only.
# DB_ECHO=0

# Prefix for the classic text commands. Deliberately not "/" -- that made every
# message beginning with a slash get parsed as a prefix command too.
# COMMAND_PREFIX=z!

# Per-person daily Gemini ceiling, in tokens. 0 (the default) means no cap.
# Needs REDIS_URL: an in-memory per-user counter would reset on restart, so with
# no Redis the cap is not enforced rather than enforced inconsistently.
# AI_USER_DAILY_TOKENS=0

# Logging. LOG_FORMAT is "plain" locally and "json" when RENDER is set, since a
# log platform can index a level and a logger name but not prose. Override
# either to force it.
# LOG_LEVEL=INFO
# LOG_FORMAT=plain

# Optional custom path for settings.json (useful for persistent Docker volumes).
# SETTINGS_PATH=./settings.json

# ─── Web dashboard (Discord OAuth) ───

# OAuth2 credentials for the dashboard — the same Discord application as the bot.
# Developer Portal → your app → OAuth2 → Client ID / Reset Secret.
# Register the redirect URI below under OAuth2 → Redirects before signing in.
# Leave these blank (along with REDIS_URL) to serve only the public weather site.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# REDIS_URL (above) is REQUIRED for the dashboard: sessions are server-side and
# shared across gunicorn workers, so they cannot live in process memory.

# Public origin of the dashboard. Render supplies RENDER_EXTERNAL_URL automatically.
# NOTE: WEB_APP_URL above is only the /use link — it is NOT used for OAuth.
# WEB_PUBLIC_URL=http://127.0.0.1:5000

# Exact redirect URI registered in the Developer Portal. Derived from
# WEB_PUBLIC_URL when omitted; set it explicitly for custom domains, and to
# http://localhost:5173/api/v1/auth/callback when developing against Vite.
# DISCORD_REDIRECT_URI=http://127.0.0.1:5000/api/v1/auth/callback

# Session lifetime, and the cookie Secure flag (auto-on for https origins).
# SESSION_TTL_SECONDS=604800
# SESSION_MAX_AGE_SECONDS=2592000
# AUTH_COOKIE_SECURE=1
