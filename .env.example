# ─────────────────────────────────────────────────────────────────────────────
# Zephyr bot configuration template.
# Copy this file to `.env` and fill in your own credentials.
#     cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=your-discord-bot-token

# OpenWeatherMap API key (https://openweathermap.org/api)
# Used by the BOT's weather commands only. The website's weather pages and the
# alert scheduler use Open-Meteo, which needs no key.
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Spotify application credentials (https://developer.spotify.com/dashboard)
# Needed by the BOT for /play with a Spotify link, and by the WEBSITE for the
# dashboard's playlist importer. Set them on both processes if you deploy them
# separately; leaving them off the website only disables that one endpoint, which
# then answers a clear 503 rather than failing obscurely.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ─── Optional overrides (sensible defaults applied if left blank) ───

# Absolute path to ffmpeg.exe. Leave blank to auto-detect the bundled ffmpeg/ folder.
FFMPEG_PATH=

# URL shown by the /use command (web app link). No default: leave it blank and /use
# reports that it is unconfigured, rather than linking somewhere that is not yours.
WEB_APP_URL=

# Flask website host/port for `python run_web.py` (PORT below wins if set).
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Werkzeug debugger + reloader for local development only. With it on, the dev
# server binds to 127.0.0.1 unless FLASK_HOST is set explicitly.
# FLASK_DEBUG=0

# ─── Cloud / container overrides ───

# PORT is set automatically by Render, Heroku, AWS, etc. It overrides FLASK_PORT for the web process.
# PORT=5000

# Redis: required by the web dashboard (sessions) and by the bot <-> dashboard
# bridge. REDISCLOUD_URL is accepted as an alias.
# REDIS_URL=redis://localhost:6379/0

# Persistent SQL database. When unset, Zephyr uses a local SQLite file,
# data/zephyr.db -- that, not settings.json, is the zero-config default.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/zephyr

# Where AI settings are stored. auto = DATABASE_URL if set, else REDIS_URL if
# set, else data/zephyr.db; settings.json is only the fallback when the chosen
# backend cannot be reached at startup.
# STORAGE_BACKEND=auto  # auto, database, redis, or file

# Create missing tables at startup (handy locally; production runs
# `alembic upgrade head` instead) and log every SQL statement.
# DB_AUTO_CREATE=1
# DB_ECHO=0

# Optional custom path for settings.json (useful for persistent Docker volumes).
# SETTINGS_PATH=./settings.json

# ─── Web dashboard (Discord OAuth) ───

# OAuth2 credentials for the dashboard — the same Discord application as the bot.
# Developer Portal → your app → OAuth2 → Client ID / Reset Secret.
# Register the redirect URI below under OAuth2 → Redirects before signing in.
# Leave both blank to serve only the public weather site. Setting just one of
# them, or setting them without REDIS_URL, fails at startup. (REDIS_URL alone
# does not: it has other jobs.)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# REDIS_URL (above) is REQUIRED for the dashboard: sessions are server-side and
# shared across gunicorn workers, so they cannot live in process memory.

# Public origin of the dashboard. Render supplies RENDER_EXTERNAL_URL automatically.
# NOTE: WEB_APP_URL above is only the /use link — it is NOT used for OAuth.
# WEB_PUBLIC_URL=http://127.0.0.1:5000

# Exact redirect URI registered in the Developer Portal. Derived from
# WEB_PUBLIC_URL when omitted; set it explicitly for custom domains, and to
# http://localhost:5173/api/v1/auth/callback when developing against Vite.
# DISCORD_REDIRECT_URI=http://127.0.0.1:5000/api/v1/auth/callback

# Session lifetime (sliding; renewed on every request), the absolute cap no
# activity extends, and the cookie Secure flag (auto-on for https origins).
# SESSION_TTL_SECONDS=604800
# SESSION_MAX_AGE_SECONDS=2592000
# AUTH_COOKIE_SECURE=1

# Cookie names, if they clash with something else on the same domain.
# AUTH_COOKIE_NAME=zephyr_session
# CSRF_COOKIE_NAME=zephyr_csrf

# How long a session's cached Discord guild list is trusted before the
# dashboard offers a refresh.
# GUILDS_FRESH_SECONDS=3600

# Trust X-Forwarded-* headers. Only enable behind a reverse proxy; it is
# switched on automatically on Render (which sets RENDER).
# TRUST_PROXY_HEADERS=0

# Permissions bitfield for the dashboard's "Add Zephyr" invite link.
# DISCORD_INVITE_PERMISSIONS=3197952
